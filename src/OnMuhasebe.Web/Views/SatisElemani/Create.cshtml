@*
    YENİ SATIŞ ELEMANI — SatisElemaniController
    GET Create()
    POST Create(SatisElemani satisElemani) → başarılıysa RedirectToAction("Index")
*@
@model SatisElemani
@{
    ViewData["Title"] = "Yeni Satış Elemanı";
}

<div class="page-header">
    <div>
        <h1>Yeni Satış Elemanı</h1>
        <p class="page-subtitle">Satış faturalarında seçilecek temsilciyi tanımlayın.</p>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-header">Satış elemanı bilgileri</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"></div>

                    <partial name="_Form" model="Model" />

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
