@*
    YETKİSİZ ERİŞİM — AccountController
    GET AccessDenied()
    Cookie authentication'ın varsayılan AccessDeniedPath'i /Account/AccessDenied'dır.
    Standart kullanıcı Yönetici sayfasına girmeye çalıştığında buraya yönlenir.
*@
@{
    ViewData["Title"] = "Yetkisiz Erişim";
}

<div class="table-card" style="max-width: 560px; margin: 40px auto 0;">
    <div class="empty-state">
        <div class="empty-state-icon" style="background: var(--danger-light); color: var(--danger);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <h3>Bu sayfaya erişim yetkiniz yok</h3>
        <p>Bu ekran yalnızca <strong>Yönetici</strong> rolündeki kullanıcılar tarafından kullanılabilir.</p>
        <a class="btn btn-primary mt-4" asp-controller="Home" asp-action="Index">Panele dön</a>
    </div>
</div>
