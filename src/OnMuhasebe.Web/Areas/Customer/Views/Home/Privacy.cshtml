@{
    ViewData["Title"] = "Hakkında";
}

<div class="page-header">
    <div>
        <h1>Hakkında</h1>
        <p class="page-subtitle">Uygulama ve kapsam bilgileri.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">Uygulama</div>
            <div class="card-body">
                <p>
                    Küçük bir işletmenin satış/alış faturalarını, cari hesaplarını, stok
                    hareketlerini ve tahsilat/ödeme işlemlerini takip edebileceği sade bir
                    ön muhasebe uygulamasıdır.
                </p>
                <p class="mb-0 text-muted" style="font-size: .85rem;">
                    Staj projesi kapsamında geliştirilmektedir.
                </p>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">Kapsam dışı</div>
            <div class="card-body">
                <ul class="mb-0" style="padding-left: 1.1rem; font-size: .9rem;">
                    <li>e-Fatura / e-Arşiv ve GİB entegrasyonu</li>
                    <li>Resmi muhasebe (mizan, defter, beyanname)</li>
                    <li>Çoklu firma, çoklu para birimi, çoklu depo</li>
                </ul>
            </div>
        </div>
    </div>
</div>
