@*
    İŞLEM MESAJI — tüm liste ve detay ekranlarında ortak
    Controller: TempData["Mesaj"] = "...";  TempData["MesajTipi"] = "success" | "warning"
    Uyarılar sarı kutuda ünlem ikonuyla, başarı mesajları onay ikonuyla gösterilir.
*@
@{
    var mesaj = TempData["Mesaj"] as string;
    var uyari = TempData["MesajTipi"] as string == "warning";
}
@if (!string.IsNullOrEmpty(mesaj))
{
    <div class="info-box @(uyari ? "is-warning" : "")" role="status">
        @if (uyari)
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="M22 4 12 14.01l-3-3" /></svg>
        }
        <span>@mesaj</span>
    </div>
}
