@* Kullanıcı Create ve Edit ekranlarının ortak alanları (şifre alanları hariç) *@
@model Kullanici
@{
    var aktif = Model?.Aktif ?? true;
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
        <label asp-for="KullaniciAdi" class="form-label">Kullanıcı adı <span class="zorunlu">*</span></label>
        <input asp-for="KullaniciAdi" class="form-control" placeholder="Örn: ayse.yilmaz" maxlength="50" autocomplete="off" required />
        <span asp-validation-for="KullaniciAdi"></span>
        <span class="form-hint">Benzersiz olmalıdır.</span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="AdSoyad" class="form-label">Ad Soyad <span class="zorunlu">*</span></label>
        <input asp-for="AdSoyad" class="form-control" placeholder="Örn: Ayşe Yılmaz" maxlength="100" required />
        <span asp-validation-for="AdSoyad"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Rol" class="form-label">Rol <span class="zorunlu">*</span></label>
    <select asp-for="Rol" class="form-select" required>
        <option value="@Sabitler.RolStandart">@Sabitler.RolStandart</option>
        <option value="@Sabitler.RolYonetici">@Sabitler.RolYonetici</option>
    </select>
    <span asp-validation-for="Rol"></span>
    <span class="form-hint">
        <strong>Yönetici:</strong> tüm ekranlar + kullanıcı yönetimi + parametreler.
        <strong>Standart:</strong> kullanıcı yönetimi ve parametreler hariç tüm ekranlar.
    </span>
</div>

<div class="form-check form-switch mb-1">
    <input class="form-check-input" type="checkbox" role="switch" id="Aktif" name="Aktif" value="true" checked="@aktif" />
    <input type="hidden" name="Aktif" value="false" />
    <label class="form-check-label" for="Aktif">Aktif</label>
</div>
<span class="form-hint">Pasif kullanıcılar sisteme giriş yapamaz.</span>
