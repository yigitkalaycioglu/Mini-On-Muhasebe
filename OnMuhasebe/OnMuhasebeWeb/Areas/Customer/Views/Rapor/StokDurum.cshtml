@*
    RAPOR: STOK DURUM LİSTESİ — RaporController
    GET StokDurum() → View(List<StokKarti>)  .Include(s => s.StokHareketleri)
*@
@model List<StokKarti>
@{
    ViewData["Title"] = "Stok Durum Listesi";

    var satirlar = Model
        .Select(s => new
        {
            Stok = s,
            Giris = s.StokHareketleri.Where(h => h.Yon == "Giris").Sum(h => h.Miktar),
            Cikis = s.StokHareketleri.Where(h => h.Yon == "Cikis").Sum(h => h.Miktar)
        })
        .Select(x => new { x.Stok, x.Giris, x.Cikis, Mevcut = x.Giris - x.Cikis })
        .Select(x => new
        {
            x.Stok, x.Giris, x.Cikis, x.Mevcut,
            Deger = Math.Max(x.Mevcut, 0) * x.Stok.AlisFiyati,
            Seviye = x.Mevcut <= 0 ? "tukendi" : x.Mevcut <= x.Stok.KritikStok ? "kritik" : "yeterli"
        })
        .OrderBy(x => x.Stok.StokKodu)
        .ToList();
}

<div class="page-header">
    <div>
        <h1>Stok Durum Listesi</h1>
        <p class="page-subtitle">@DateTime.Now.ToString("dd.MM.yyyy HH:mm") itibarıyla · Mevcut = Σ Giriş − Σ Çıkış</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button type="button" class="btn btn-outline-secondary" data-yazdir>Yazdır</button>
        <a asp-action="Index" class="btn btn-outline-secondary">← Raporlar</a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat">
        <div class="stat-label">Ürün sayısı</div>
        <div class="stat-value">@satirlar.Count</div>
    </div>
    <div class="stat">
        <div class="stat-label">Kritik / tükenen</div>
        <div class="stat-value">@satirlar.Count(x => x.Seviye == "kritik") / @satirlar.Count(x => x.Seviye == "tukendi")</div>
    </div>
    <div class="stat">
        <div class="stat-label">Stok değeri (alış, TL)</div>
        <div class="stat-value">@satirlar.Sum(x => x.Deger).ToString("N2")</div>
    </div>
</div>

<div class="table-card">
    <div class="filter-bar">
        <div class="filter-item filter-search">
            <label for="arama">Ara</label>
            <input id="arama" type="search" class="form-control" placeholder="Stok kodu veya adı..." data-tablo-arama="#tablo" />
        </div>
        <div class="filter-item">
            <label for="seviye">Seviye</label>
            <select id="seviye" class="form-select" data-tablo-secim="#tablo" data-alan="seviye">
                <option value="">Tümü</option>
                <option value="yeterli">Yeterli</option>
                <option value="kritik">Kritik</option>
                <option value="tukendi">Tükendi</option>
            </select>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="table" id="tablo">
            <thead>
                <tr>
                    <th style="width: 100px;">Kod</th>
                    <th>Stok Adı</th>
                    <th>Birim</th>
                    <th class="cell-number">Giriş</th>
                    <th class="cell-number">Çıkış</th>
                    <th class="cell-number">Mevcut</th>
                    <th class="cell-number">Kritik Sev.</th>
                    <th>Durum</th>
                    <th class="cell-number">Değer (TL)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in satirlar)
                {
                    <tr data-seviye="@x.Seviye">
                        <td class="text-mono">@x.Stok.StokKodu</td>
                        <td class="cell-strong">@x.Stok.StokAdi</td>
                        <td class="cell-muted">@x.Stok.Birim</td>
                        <td class="cell-number">@x.Giris.ToString("N2")</td>
                        <td class="cell-number">@x.Cikis.ToString("N2")</td>
                        <td class="cell-number cell-strong">@x.Mevcut.ToString("N2")</td>
                        <td class="cell-number cell-muted">@x.Stok.KritikStok.ToString("N2")</td>
                        <td>
                            @if (x.Seviye == "tukendi") { <span class="badge-soft badge-danger">Tükendi</span> }
                            else if (x.Seviye == "kritik") { <span class="badge-soft badge-warning">Kritik</span> }
                            else { <span class="badge-soft badge-success">Yeterli</span> }
                        </td>
                        <td class="cell-number">@x.Deger.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="8">Toplam stok değeri</td>
                    <td class="cell-number">@satirlar.Sum(x => x.Deger).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="table-footer">
        <span data-tablo-sayac="#tablo">@satirlar.Count</span> ürün · Stok değeri = mevcut miktar × alış fiyatı
    </div>
</div>
