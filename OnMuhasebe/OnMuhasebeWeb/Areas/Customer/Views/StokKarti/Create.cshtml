@*
    YENİ STOK KARTI — StokKartiController
    GET  Create()                 (isteğe bağlı: ViewData["VarsayilanKdv"] = parametredeki KDV oranı)
    POST Create(StokKarti stokKarti) → başarılıysa RedirectToAction("Index")
*@
@model StokKarti
@{
    ViewData["Title"] = "Yeni Stok Kartı";
}

<div class="page-header">
    <div>
        <h1>Yeni Stok Kartı</h1>
        <p class="page-subtitle">Ürün, birim, KDV ve fiyat bilgilerini tanımlayın.</p>
    </div>
</div>

<div class="row">
    <div class="col-12 col-xl-9">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"></div>

                    <partial name="_Form" model="Model" />

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
