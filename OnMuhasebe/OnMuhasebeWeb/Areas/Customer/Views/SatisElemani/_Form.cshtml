@* Satış elemanı Create ve Edit ekranlarının ortak alanları *@
@model SatisElemani
@{
    var aktif = Model?.Aktif ?? true;
}

<div class="mb-3">
    <label asp-for="AdSoyad" class="form-label">Ad Soyad <span class="zorunlu">*</span></label>
    <input asp-for="AdSoyad" class="form-control" placeholder="Örn: Mehmet Demir" maxlength="100" required />
    <span asp-validation-for="AdSoyad"></span>
</div>

<div class="mb-3">
    <label asp-for="Telefon" class="form-label">Telefon <span class="zorunlu">*</span></label>
    <input asp-for="Telefon" type="tel" class="form-control" placeholder="Örn: 0555 111 22 33" maxlength="20"
           required />
    <span asp-validation-for="Telefon"></span>
</div>

<div class="form-check form-switch mb-1">
    <input class="form-check-input" type="checkbox" role="switch" id="Aktif" name="Aktif" value="true"
           checked="@aktif" />
    <input type="hidden" name="Aktif" value="false" />
    <label class="form-check-label" for="Aktif">Aktif</label>
</div>
<span class="form-hint">Pasif satış elemanları satış faturasında seçilemez.</span>
