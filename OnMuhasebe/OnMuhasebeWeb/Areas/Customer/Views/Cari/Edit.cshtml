@*
    CARİ KARTI (DÜZENLE) — CariController
    GET  Edit(int id)            → View(cari)   (hesap özeti için .Include(c => c.CariHareketleri))
    POST Edit(int id, Cari cari) → başarılıysa RedirectToAction("Index")
*@
@model Cari
@{
    ViewData["Title"] = "Cari Kartı";

    var ozet = ViewData["Ozet"] as CariOzetiViewModel ?? new CariOzetiViewModel();
    var toplamBorc = ozet.ToplamBorc;
    var toplamAlacak = ozet.ToplamAlacak;
    var bakiye = ozet.Bakiye;
}

<div class="page-header">
    <div>
        <h1>@Model.Unvan</h1>
        <p class="page-subtitle"><span class="text-mono">@Model.CariKodu</span></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Ekstre" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cari Ekstre</a>
        <a asp-action="Index" class="btn btn-outline-secondary">← Listeye dön</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input type="hidden" asp-for="Id" />

                    <partial name="_Form" model="Model" />

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">Hesap özeti</div>
            <div class="card-body">
                <div class="toplamlar" style="max-width: none;">
                    <div class="toplamlar-satir">
                        <span>Toplam borç</span>
                        <span>@toplamBorc.ToString("N2") TL</span>
                    </div>
                    <div class="toplamlar-satir">
                        <span>Toplam alacak</span>
                        <span>@toplamAlacak.ToString("N2") TL</span>
                    </div>
                    <div class="toplamlar-satir genel">
                        <span>Bakiye</span>
                        <span>
                            @Math.Abs(bakiye).ToString("N2") TL
                            @if (bakiye > 0) { <span class="bakiye-etiket">(B)</span> }
                            else if (bakiye < 0) { <span class="bakiye-etiket">(A)</span> }
                        </span>
                    </div>
                </div>
                <span class="form-hint mt-3">
                    @Model.CariHareketleri.Count hareket ·
                    <strong>(B)</strong> cari bize borçlu, <strong>(A)</strong> biz cariye borçluyuz.
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
