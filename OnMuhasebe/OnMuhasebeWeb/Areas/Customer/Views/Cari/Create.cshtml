@*
    YENİ CARİ KARTI — CariController
    GET  Create()
    POST Create(Cari cari) → başarılıysa RedirectToAction("Index")
*@
@model Cari
@{
    ViewData["Title"] = "Yeni Cari";
}

<div class="page-header">
    <div>
        <h1>Yeni Cari Kartı</h1>
        <p class="page-subtitle">Müşteri veya tedarikçi hesabı açın.</p>
    </div>
</div>

<div class="row">
    <div class="col-12 col-xl-9">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"></div>

                    <partial name="_Form" model="Model" />

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
