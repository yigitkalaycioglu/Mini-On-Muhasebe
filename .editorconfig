# Kod biçimi kuralları. Editörler (Visual Studio, VS Code, Rider) bu dosyayı otomatik uygular.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,props,csproj,slnx,xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# using sıralaması: System önce
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Projedeki mevcut stil: blok namespace, her if/foreach gövdesi süslü parantezli
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all

# var yalnızca tür sağ taraftan anlaşılıyorsa
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Adlandırma: arayüzler I ile başlar
dotnet_naming_rule.arayuzler_i_ile_baslar.symbols = arayuzler
dotnet_naming_rule.arayuzler_i_ile_baslar.style = i_onekli
dotnet_naming_rule.arayuzler_i_ile_baslar.severity = suggestion
dotnet_naming_symbols.arayuzler.applicable_kinds = interface
dotnet_naming_style.i_onekli.required_prefix = I
dotnet_naming_style.i_onekli.capitalization = pascal_case

# EF Core'un ürettiği migration dosyaları elle düzenlenmez
[**/Migrations/*.cs]
generated_code = true
